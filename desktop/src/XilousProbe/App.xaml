<Application x:Class="XilousProbe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1A1A1A" />
        <SolidColorBrush x:Key="Muted" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Line" Color="#E2E2E2" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Canvas" Color="#F6F6F4" />
        <SolidColorBrush x:Key="Accent" Color="#38A3F5" />
        <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    </Application.Resources>
</Application>
