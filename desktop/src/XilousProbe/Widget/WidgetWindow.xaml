<Window x:Class="XilousProbe.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xilous Probe" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="400" Height="300" Left="-32000" Top="-32000"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#F4F1EC">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1F1E1C" />
        <SolidColorBrush x:Key="CardLine" Color="#3A3835" />
        <SolidColorBrush x:Key="FieldBrush" Color="#141414" />
        <SolidColorBrush x:Key="FieldLine" Color="#45423E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B5AFA6" />
        <SolidColorBrush x:Key="FaintBrush" Color="#8A847B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D97757" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root">
        <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLine}"
                CornerRadius="14,0,0,14" BorderThickness="1,1,0,1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.35" />
            </Border.Effect>
            <Grid>
                <!-- The expanded content, laid out at full size, pinned to the edge's corner, fading in. -->
                <Canvas x:Name="BodyHost">
                <Grid x:Name="Body" Width="300" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="Header" Grid.Row="0" Height="52" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeaderLeft" Width="*" />
                            <ColumnDefinition x:Name="HeaderRight" Width="40" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="HeaderText" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PointLabel" Text="Not pointing" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="HotkeyLabel" Text="Ctrl+Shift+X · Esc steps back" FontFamily="{StaticResource Mono}"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="Footer" Grid.Row="2" BorderBrush="#33312E" BorderThickness="0,1,0,0" Margin="16,0" Padding="0,10,0,12">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource FaintBrush}" />
                            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#C9C3BA" />
                        </DockPanel>
                    </Border>
                </Grid>
                </Canvas>

                <!-- The round button: always in the corner on the edge's side. Click toggles Point Mode; drag moves the widget. -->
                <Grid x:Name="Disc" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="Transparent" Cursor="Hand" ToolTip="Point Mode (Ctrl+Shift+X). Drag to move.">
                    <Ellipse x:Name="Ring" Width="34" Height="34" StrokeThickness="2" Stroke="#5A5650" Fill="Transparent" />
                    <Path x:Name="Crosshair" Width="18" Height="18" Stretch="Uniform" Stroke="#B5AFA6" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M12,5 A7,7 0 1 1 11.99,5 Z M12,1 L12,5 M12,19 L12,23 M1,12 L5,12 M19,12 L23,12" />
                    <Ellipse x:Name="Center" Width="3" Height="3" Fill="#B5AFA6" />
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
