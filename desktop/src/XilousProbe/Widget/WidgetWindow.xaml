<Window x:Class="XilousProbe.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xilous Probe" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="400" Height="300" Left="-32000" Top="-32000"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <!-- Set from the Xilous theme at start and whenever it changes (ApplyTheme). -->
        <SolidColorBrush x:Key="InkBrush" Color="#ECEFF2" />
        <SolidColorBrush x:Key="DimBrush" Color="#C3C7CC" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="CardLine" Color="#3A3B3F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6" />
        <SolidColorBrush x:Key="FaintBrush" Color="#7A7F85" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38A3F5" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root">
        <Border x:Name="Card" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardLine}"
                CornerRadius="31" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- The expanded content, laid out at full size, pinned to the edge's corner, fading in. -->
                <Canvas x:Name="BodyHost">
                <Grid x:Name="Body" Width="300" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="Header" Grid.Row="0" Height="62" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeaderLeft" Width="*" />
                            <ColumnDefinition x:Name="HeaderRight" Width="52" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="HeaderText" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PointLabel" Text="Not pointing" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="HotkeyLabel" Text="Ctrl+Shift+X · Esc steps back" FontFamily="{StaticResource Mono}"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="Footer" Grid.Row="2" BorderBrush="{DynamicResource CardLine}" BorderThickness="0,1,0,0" Margin="16,0" Padding="0,10,0,12">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource FaintBrush}" />
                            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource DimBrush}" />
                        </DockPanel>
                    </Border>
                </Grid>
                </Canvas>

                <!-- The ring gauge, as on the Xilous Usage Monitor: always in the corner on the edge's side.
                     Its arc sweeps round while pointing. Click toggles Point Mode; drag moves the widget. -->
                <Grid x:Name="Disc" Width="62" Height="62" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="Transparent" Cursor="Hand" ToolTip="Point Mode (Ctrl+Shift+X). Drag to move.">
                    <Ellipse x:Name="Ring" Width="50" Height="50" StrokeThickness="5" Fill="Transparent" />
                    <Path x:Name="Arc" Width="50" Height="50" Stretch="None" StrokeThickness="5" Opacity="0"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"
                          Data="M25,2.5 A22.5,22.5 0 1 1 3.6,31.95">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ArcSpin" />
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Crosshair" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M12,5 A7,7 0 1 1 11.99,5 Z M12,1 L12,5 M12,19 L12,23 M1,12 L5,12 M19,12 L23,12" />
                    <Ellipse x:Name="Center" Width="3" Height="3" />
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
