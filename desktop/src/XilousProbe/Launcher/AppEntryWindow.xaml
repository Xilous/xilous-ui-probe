<Window x:Class="XilousProbe.Launcher.AppEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" FontFamily="{StaticResource Ui}" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource Label}" Text="Name" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" />

        <TextBlock Style="{StaticResource Label}" Text="How it starts" />
        <ComboBox x:Name="KindBox" MinHeight="30" SelectionChanged="OnKindChanged">
            <ComboBoxItem Content="Dev command (for example electron-vite dev)" Tag="DevCommand" />
            <ComboBoxItem Content="Packaged .exe" Tag="Executable" />
            <ComboBoxItem Content="Attach to an app already running with remote debugging" Tag="Attach" />
        </ComboBox>

        <StackPanel x:Name="CommandPanel">
            <TextBlock x:Name="CommandLabel" Style="{StaticResource Label}" Text="Command" />
            <DockPanel>
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Padding="10,0" Click="OnBrowse" />
                <TextBox x:Name="CommandBox" FontFamily="{StaticResource Mono}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Label}" Text="Arguments ({port} is the debugging port)" />
            <TextBox x:Name="ArgsBox" FontFamily="{StaticResource Mono}" />
            <TextBlock Style="{StaticResource Label}" Text="Working directory" />
            <TextBox x:Name="DirBox" FontFamily="{StaticResource Mono}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Label}" Text="Debugging port" />
        <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left" FontFamily="{StaticResource Mono}" />
        <TextBlock x:Name="Hint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock x:Name="Error" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,6,0,0" />

        <DockPanel Margin="0,18,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Remove" Padding="12,5" Click="OnDelete" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="12,5" Margin="0,0,8,0" />
                <Button Content="Save" IsDefault="True" Padding="16,5" Click="OnSave" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
